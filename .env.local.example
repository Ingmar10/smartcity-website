# Copy to .env.local for local development. NEVER commit real values.
# In production these are set as Vercel Environment Variables.

# Anthropic API key — powers the Bolt chat widget (/api/bolt).
# Get one at https://console.anthropic.com. Injected in Vercel, not committed.
ANTHROPIC_API_KEY=

# Vercel Postgres connection string — stores DialBolt TCPA consent records.
# Auto-populated when you provision Vercel Postgres and link it to the project.
# Leave blank locally to use the .data/consent.jsonl file fallback instead.
POSTGRES_URL=

# Public site URL (used for canonical/OG metadata). Defaults to the live domain.
NEXT_PUBLIC_SITE_URL=https://smartctycontractors.com

# Resend API key — sends the lead notification on POST /api/waitlist.
# Get one at https://resend.com/api-keys. Without it the endpoint still stores
# the lead and logs a loud failure; it never returns an error to the visitor.
RESEND_API_KEY=

# Where lead notifications are delivered. Defaults to smartcitycontractors@gmail.com.
WAITLIST_NOTIFY_TO=

# Sender for lead notifications. Defaults to Resend's shared, no-verification
# sender: "SmartCity Leads <onboarding@resend.dev>". Swap to
# "SmartCity Leads <notifications@smartcity.contractors>" once that domain is
# verified in Resend — this is an env change, no deploy needed.
WAITLIST_FROM_EMAIL=
